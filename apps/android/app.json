{
  "expo": {
    "name": "Biblesyn",
    "slug": "biblesyn",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "biblesyn",
    "newArchEnabled": true,
    "android": {
      "package": "online.blui.biblesyn",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["INTERNET", "VIBRATE"]
    },
    "plugins": [
      ["expo-build-properties", {
        "android": {
          "usesCleartextTraffic": false
        }
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "CONFIGURE_EAS_PROJECT_ID"
      }
    }
  }
}